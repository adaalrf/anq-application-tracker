DATABASE_URL=postgres://postgres:local-development-only@127.0.0.1:55433/application_tracker
APP_ORIGIN=http://localhost:5174
HOST=127.0.0.1
PORT=8081
DEMO_MODE=true
OWNER_USERNAME=owner
# Required for owner mode; generate a scrypt hash with npm run password.
OWNER_PASSWORD_HASH=

# Optional: exact sanitizing-proxy IPs; self is for verified rootless port forwarding.
# Keep backend host ports loopback-only. Empty means forwarded headers are ignored.
TRUST_PROXY_IPS=
